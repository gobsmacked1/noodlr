{{! Noodlr players-only "Ask the Table" panel. Static shell; bubbles are added imperatively
    (see player-panel.ts). }}
<section class="noodlr-chat">
  <div class="noodlr-chat__banner noodlr-player__intro">
    <i class="fa-solid fa-masks-theater"></i>
    {{localize "NOODLR.Players.Intro"}}
  </div>

  <div class="noodlr-chat__log" data-role="log"></div>

  <footer class="noodlr-chat__composer">
    <textarea
      data-role="input"
      rows="2"
      placeholder="{{inputPlaceholder}}"
      disabled
    ></textarea>
    <button type="button" data-role="send" title="{{localize "NOODLR.Players.Send"}}" disabled>
      <i class="fa-solid fa-paper-plane"></i>
    </button>
  </footer>

  <p class="noodlr-chat__version">v{{version}}</p>
</section>

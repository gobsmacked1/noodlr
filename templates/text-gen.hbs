{{! Text Generation: chat provider, the assistant's name, every text prompt, and context controls. }}
<section class="noodlr-settings">
  <header class="noodlr-settings__header">
    <i class="fa-solid fa-comments"></i>
    <h2>{{moduleTitle}} — {{localize "NOODLR.TextGen.Menu.Name"}}</h2>
    <span class="noodlr-settings__version">v{{version}}</span>
  </header>

  <p class="noodlr-settings__intro">{{localize "NOODLR.TextGen.Intro"}}</p>

  <datalist id="noodlr-or-models"></datalist>

  {{! ---- The chat model itself ---- }}
  <fieldset class="noodlr-settings__section" data-feature="chat">
    <legend><i class="fa-solid fa-comments"></i> {{chat.title}}</legend>
    {{> noodlrHelp chat}}
    {{> noodlrProviderBlock chat}}

    <div class="noodlr-settings__actions">
      <button type="button" data-action="testConnection">
        <i class="fa-solid fa-plug"></i> {{localize "NOODLR.Settings.TestConnection"}}
      </button>
    </div>

    <label class="noodlr-inline">
      <input type="checkbox" name="chat.continueAfterRoll" {{#if continueAfterRoll}}checked{{/if}} />
      {{localize "NOODLR.Settings.ChatContinueAfterRoll.Name"}}
    </label>
    <p class="notes">{{localize "NOODLR.Settings.ChatContinueAfterRoll.Hint"}}</p>

    <div class="noodlr-field">
      <label>{{localize "NOODLR.Settings.AssistantName.Name"}}</label>
      <p class="notes">{{localize "NOODLR.Settings.AssistantName.Hint"}}</p>
      <input type="text" name="assistantName" value="{{assistantName}}"
        maxlength="{{assistantNameMax}}" autocomplete="off" />
    </div>
  </fieldset>

  {{! ---- The three chat prompts ---- }}
  <fieldset class="noodlr-settings__section">
    <legend><i class="fa-solid fa-scroll"></i> {{localize "NOODLR.Settings.PromptsLegend"}}</legend>
    <p class="notes">{{localize "NOODLR.Settings.PromptsNote"}}</p>

    {{> noodlrPromptField chatPrompt}}

    {{! Stated, never inferred: a model with no authoritative system will deduce one from an
        adventure's title. Sits under the main prompt because it qualifies everything above it. }}
    <div class="noodlr-field">
      <label>{{localize "NOODLR.Settings.Ruleset.Name"}}</label>
      <p class="notes">{{localize "NOODLR.Settings.Ruleset.Hint"}}</p>
      <select name="rulesetChoice" data-role="ruleset-choice">
        <option value="auto" {{#if ruleset.isAuto}}selected{{/if}}>
          {{localize "NOODLR.Settings.Ruleset.Auto"}}{{#if ruleset.detected}} — {{ruleset.detected}}{{/if}}
        </option>
        {{#each ruleset.options}}
          <option value="{{this.name}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
        <option value="custom" {{#if ruleset.isCustom}}selected{{/if}}>{{localize "NOODLR.Settings.Ruleset.Custom"}}</option>
      </select>
      <div data-role="ruleset-custom">
        <input type="text" name="rulesetCustom" value="{{ruleset.custom}}"
          maxlength="{{ruleset.customMax}}" autocomplete="off"
          placeholder="{{localize 'NOODLR.Settings.Ruleset.CustomPlaceholder'}}" />
      </div>
      <p class="notes">
        <i class="fa-solid fa-circle-info"></i>
        {{localize "NOODLR.Settings.Ruleset.Injected"}} <code>{{ruleset.resolved}}</code>
      </p>
    </div>

    {{! How much of a hostile creature's turn Noodlr runs, and whether it speaks while doing it. }}
    <div class="noodlr-field">
      <label>{{localize "NOODLR.Combat.Automation.Name"}}</label>
      <p class="notes">{{localize "NOODLR.Combat.Automation.Hint"}}</p>
      <select name="combatAutomation">
        <option value="full" {{#if automation.isFull}}selected{{/if}}>{{localize "NOODLR.Combat.Automation.Full"}}</option>
        <option value="partial" {{#if automation.isPartial}}selected{{/if}}>{{localize "NOODLR.Combat.Automation.Partial"}}</option>
        <option value="off" {{#if automation.isOff}}selected{{/if}}>{{localize "NOODLR.Combat.Automation.Off"}}</option>
      </select>
    </div>

    <div class="noodlr-field">
      <label>{{localize "NOODLR.Combat.Pace.Name"}}</label>
      <p class="notes">{{localize "NOODLR.Combat.Pace.Hint"}}</p>
  <input type="number" name="combatTurnPace" value="{{turnPace}}" min="0" max="60" step="1" />
</div>

    <div class="noodlr-field">
      <label>{{localize "NOODLR.Combat.MoveSpeed.Name"}}</label>
      <p class="notes">{{localize "NOODLR.Combat.MoveSpeed.Hint"}}</p>
      <input type="number" name="combatMoveSpeed" value="{{moveSpeed}}" min="0" max="20" step="1" />
    </div>

    <label class="noodlr-inline">
      <input type="checkbox" name="combatAutoEngage" {{#if autoEngage}}checked{{/if}} />
      {{localize "NOODLR.Combat.AutoEngage.Name"}}
    </label>
    <p class="notes">{{localize "NOODLR.Combat.AutoEngage.Hint"}}</p>

    <div class="noodlr-field">
      <label>{{localize "NOODLR.Combat.EngageRadius.Name"}}</label>
      <p class="notes">{{localize "NOODLR.Combat.EngageRadius.Hint"}}</p>
      <input type="number" name="combatEngageRadius" value="{{engageRadius}}" min="0" step="5" />
      <span class="units">{{distanceUnits}}</span>
    </div>

    <label class="noodlr-inline">
      <input type="checkbox" name="combatStealth" {{#if stealthContest}}checked{{/if}} />
      {{localize "NOODLR.Combat.Stealth.Name"}}
    </label>
    <p class="notes">{{localize "NOODLR.Combat.Stealth.Hint"}}</p>

    {{! Applies to players only. Creatures Noodlr runs are always held to the rules exactly. }}
    <div class="noodlr-field">
      <label>{{localize "NOODLR.Combat.Economy.Name"}}</label>
      <p class="notes">{{localize "NOODLR.Combat.Economy.Hint"}}</p>
      <select name="combatEconomy">
        <option value="off" {{#if economy.isOff}}selected{{/if}}>{{localize "NOODLR.Combat.Economy.Off"}}</option>
        <option value="warn" {{#if economy.isWarn}}selected{{/if}}>{{localize "NOODLR.Combat.Economy.Warn"}}</option>
        <option value="block" {{#if economy.isBlock}}selected{{/if}}>{{localize "NOODLR.Combat.Economy.Block"}}</option>
      </select>
    </div>

    <label class="noodlr-inline">
      <input type="checkbox" name="combatMovement" {{#if movementCap}}checked{{/if}} />
      {{localize "NOODLR.Combat.Movement.Name"}}
    </label>
    <p class="notes">{{localize "NOODLR.Combat.Movement.Hint"}}</p>

    <label class="noodlr-inline">
      <input type="checkbox" name="combatForced" {{#if forcedMovement}}checked{{/if}} />
      {{localize "NOODLR.Combat.Forced.Name"}}
    </label>
    <p class="notes">{{localize "NOODLR.Combat.Forced.Hint"}}</p>

    <label class="noodlr-inline">
      <input type="checkbox" name="combatAutoEnd" {{#if autoEnd}}checked{{/if}} />
      {{localize "NOODLR.Combat.AutoEnd.Name"}}
    </label>
    <p class="notes">{{localize "NOODLR.Combat.AutoEnd.Hint"}}</p>

    <label class="noodlr-inline">
      <input type="checkbox" name="npcBanter" {{#if npcBanter}}checked{{/if}} />
      {{localize "NOODLR.Combat.Banter.Name"}}
    </label>
    <p class="notes">{{localize "NOODLR.Combat.Banter.Hint"}}</p>

    {{> noodlrPromptField playersPrompt}}
    {{> noodlrPromptField adjudicationPrompt}}
    {{> noodlrPromptField combatPrompt}}
  </fieldset>

  {{! ---- Context & injections ---- }}
  <fieldset class="noodlr-settings__section">
    <legend><i class="fa-solid fa-layer-group"></i> {{localize "NOODLR.Settings.ContextLegend"}}</legend>

    {{> noodlrPromptField authorNote}}

    <div class="noodlr-field">
      <label>{{localize "NOODLR.Prompt.AuthorNoteDepth.Name"}}</label>
      <p class="notes">{{localize "NOODLR.Prompt.AuthorNoteDepth.Hint"}}</p>
      <input type="number" name="authorNoteDepth" value="{{authorNoteDepth}}" min="0" max="50" step="1" />
    </div>

    {{> noodlrPromptField postHistory}}
    {{> noodlrPromptField combatReminder}}

    <div class="noodlr-field">
      <label>{{localize "NOODLR.Prompt.ContextBudget.Name"}}</label>
      <p class="notes">{{localize "NOODLR.Prompt.ContextBudget.Hint"}}</p>
      <input type="number" name="contextTokenBudget" value="{{contextTokenBudget}}" min="1000" max="1000000" step="1000" />
    </div>
  </fieldset>

  {{! ---- Behavior toggles that change what the models are told ---- }}
  <fieldset class="noodlr-settings__section">
    <legend><i class="fa-solid fa-sliders"></i> {{localize "NOODLR.Settings.BehaviorLegend"}}</legend>

    <label class="noodlr-inline">
      <input type="checkbox" name="memoryWrites" {{#if memoryWrites}}checked{{/if}} />
      {{localize "NOODLR.Prompt.ChatMemoryWrites.Name"}}
    </label>
    <p class="notes">{{localize "NOODLR.Prompt.ChatMemoryWrites.Hint"}}</p>

    <label class="noodlr-inline">
      <input type="checkbox" name="tipsterGm" {{#if tipsterGm}}checked{{/if}} />
      {{localize "NOODLR.Prompt.TipsterGm.Name"}}
    </label>
    <p class="notes">{{localize "NOODLR.Prompt.TipsterGm.Hint"}}</p>

    <label class="noodlr-inline">
      <input type="checkbox" name="tipsterPlayers" {{#if tipsterPlayers}}checked{{/if}} />
      {{localize "NOODLR.Prompt.TipsterPlayers.Name"}}
    </label>
    <p class="notes">{{localize "NOODLR.Prompt.TipsterPlayers.Hint"}}</p>
  </fieldset>
</section>
